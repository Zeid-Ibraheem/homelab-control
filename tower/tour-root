#!/usr/bin/env bash
# =============================================================================
# tour-root : les SEULES actions de la tour qui demandent les droits root.
#
# Lancé par le compte homelab via sudo, avec un argument fixe autorisé dans
# /etc/sudoers.d/homelab-tower. Ne lit aucune variable d'environnement : sudo
# les efface, et les chemins sont écrits en dur.
#
#   poweroff   éteint la tour dans 3 secondes
#   reboot     redémarre la tour dans 3 secondes
#   health     lecture seule : santé des disques (SMART) et sécurité sur 24 h
#              (connexions SSH, pare-feu), en fragment JSON
#   restart S  redémarre le service S, s'il est dans TOWER_RESTARTABLE (sudo
#              n'autorise d'ailleurs que ces services, un par un)
#
# Le délai de 3 secondes laisse le temps à la réponse de repartir avant que le
# réseau ne coupe.
# =============================================================================
set -euo pipefail
umask 022
PATH=/usr/sbin:/usr/bin:/sbin:/bin

case "$#:${1:-}" in
  1:poweroff|1:reboot|1:health|2:restart) ;;
  *) echo "usage : tour-root poweroff|reboot|health|restart SERVICE" >&2; exit 2 ;;
esac

case "$1" in
  poweroff|reboot)
    systemd-run --quiet --on-active=3 --timer-property=AccuracySec=1s \
      --description="homelab : $1 demandé à distance" "$(command -v systemctl)" "$1"
    ;;
  health)
    # shellcheck source=../common/lib.sh
    . /usr/local/lib/homelab/lib.sh
    hl_load_conf /etc/homelab/homelab.conf || { echo "configuration illisible" >&2; exit 1; }
    printf '%s,%s\n' "$(hl_disks_json "${TOWER_SMART_DEVICES:-}")" "$(hl_security_json)"
    ;;
  restart)
    # shellcheck source=../common/lib.sh
    . /usr/local/lib/homelab/lib.sh
    hl_load_conf /etc/homelab/homelab.conf || { echo "configuration illisible" >&2; exit 1; }
    hl_restart_service "$2" "${TOWER_RESTARTABLE:-}"
    ;;
  *)
    echo "action inconnue" >&2
    exit 2
    ;;
esac
