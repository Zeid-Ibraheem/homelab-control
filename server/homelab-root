#!/usr/bin/env bash
# =============================================================================
# homelab-root : les SEULES actions du serveur qui demandent les droits root.
#
# Lancé par l'utilisateur homelab via sudo, avec un argument fixe autorisé dans
# /etc/sudoers.d/homelab. Ne lit aucune variable d'environnement : sudo les
# efface, et les chemins sont écrits en dur ci-dessous.
#
#   wake     relance le lien vers la tour si besoin, envoie le paquet magique,
#            puis lance la tâche qui signalera à la tour, dès qu'elle répond,
#            que cet allumage vient du serveur (homelab wake-follow)
#   health   lecture seule : santé des disques (SMART) et sécurité sur 24 h
#            (connexions SSH, pare-feu), en fragment JSON
#   restart S  redémarre le service S, s'il est dans SERVER_RESTARTABLE (sudo
#            n'autorise d'ailleurs que ces services, un par un)
# =============================================================================
set -euo pipefail
umask 022
PATH=/usr/sbin:/usr/bin:/sbin:/bin

# shellcheck source=../common/lib.sh
. /usr/local/lib/homelab/lib.sh
hl_load_conf /etc/homelab/homelab.conf || { echo "configuration illisible" >&2; exit 1; }

case "$#:${1:-}" in
  1:wake|1:health|2:restart) ;;
  *) echo "usage : homelab-root wake|health|restart SERVICE" >&2; exit 2 ;;
esac

carrier() { [ "$(cat "/sys/class/net/$LINK_INTERFACE/carrier" 2>/dev/null)" = "1" ]; }

case "$1" in
  wake)
    hl_valid_iface "${LINK_INTERFACE:-}" || { echo "LINK_INTERFACE invalide" >&2; exit 3; }
    hl_valid_mac "${TOWER_MAC:-}"        || { echo "TOWER_MAC invalide" >&2; exit 3; }
    [ -e "/sys/class/net/$LINK_INTERFACE" ] || { echo "interface $LINK_INTERFACE absente" >&2; exit 4; }
    # Certains adaptateurs USB perdent la détection du câble quand la tour
    # s'éteint : sans signal, le système refuse d'envoyer quoi que ce soit.
    if ! carrier; then
      ip link set "$LINK_INTERFACE" down
      sleep 2
      ip link set "$LINK_INTERFACE" up
      for _ in 1 2 3 4 5 6 7 8; do
        carrier && break
        sleep 1
      done
    fi
    etherwake -i "$LINK_INTERFACE" "$TOWER_MAC"
    # Tâche à part, avec le compte homelab, limitée à 10 minutes ; une seule à
    # la fois (si elle tourne déjà, systemd refuse la seconde).
    systemd-run --quiet --no-block --collect --unit=homelab-wake-follow \
      --uid=homelab --gid=homelab -p RuntimeMaxSec=600 \
      /usr/local/bin/homelab wake-follow >/dev/null 2>&1 || true
    ;;
  health)
    printf '%s,%s\n' "$(hl_disks_json "${SERVER_SMART_DEVICES:-}")" "$(hl_security_json)"
    ;;
  restart)
    hl_restart_service "$2" "${SERVER_RESTARTABLE:-}"
    ;;
  *)
    echo "action inconnue" >&2
    exit 2
    ;;
esac
