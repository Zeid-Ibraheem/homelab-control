#!/usr/bin/env bash
# =============================================================================
# homelab : point d'entrée unique du téléphone vers le serveur.
#
# Appelé par SSH avec la clé « actions » (commande forcée). La commande envoyée
# par le client arrive dans SSH_ORIGINAL_COMMAND : elle n'est JAMAIS exécutée
# telle quelle, elle est comparée à une liste fermée d'actions.
#
# Actions :
#   status          état du serveur, du câble et de la tour (JSON)
#   health          santé du serveur et de la tour : services, disques, sécurité
#   wake            allume la tour (paquet magique par le câble direct)
#   tower-off       éteint la tour
#   tower-reboot    redémarre la tour
#   extend [H]      repousse l'extinction automatique de la tour de H heures
#   extend-min M    repousse l'extinction automatique de la tour de M minutes
#   off-in N        extinction automatique de la tour dans N minutes
#   hold on|off     « ne pas éteindre » jusqu'au plafond, ou annuler
#   restart S       redémarre le service S du serveur, s'il est dans SERVER_RESTARTABLE
#   tower-restart S redémarre le service S de la tour (autorisé par sa configuration)
#   log [N]         les N dernières actions du journal (1 à 200, défaut 20)
#   actions         liste des actions disponibles
#   version         version du script
# En local seulement (jamais via SSH) :
#   wake-follow     après un réveil, signale à la tour, dès qu'elle répond, que
#                   l'allumage vient du serveur (lancé par homelab-root wake)
#
# Réponse : une ligne JSON. Code de sortie : 0 = ok, 1 = échec, 2 = refusé.
# Utilisation locale sur le serveur : sudo -u homelab homelab status
# =============================================================================
set -uo pipefail
umask 027
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

LIB=/usr/local/lib/homelab/lib.sh
CONF=/etc/homelab/homelab.conf
STATE_DIR=/var/lib/homelab/state
ROOT_HELPER=/usr/local/lib/homelab/homelab-root
RELAY_KEY=/var/lib/homelab/.ssh/id_tower
RELAY_KNOWN=/var/lib/homelab/.ssh/known_hosts_tower
RELAY_TIMEOUT=10        # secondes, pour une commande relayée vers la tour
FOLLOW_TRIES=54         # wake-follow : 54 essais, toutes les 10 s (9 minutes)
FOLLOW_PAUSE=10

# En local uniquement (jamais via SSH), les chemins peuvent être changés pour les tests.
if [ -z "${SSH_CONNECTION:-}" ]; then
  LIB=${HOMELAB_LIB:-$LIB}
  CONF=${HOMELAB_CONF:-$CONF}
  STATE_DIR=${HOMELAB_STATE:-$STATE_DIR}
  FOLLOW_TRIES=${HOMELAB_FOLLOW_TRIES:-$FOLLOW_TRIES}
  FOLLOW_PAUSE=${HOMELAB_FOLLOW_PAUSE:-$FOLLOW_PAUSE}
fi
[[ $FOLLOW_TRIES =~ ^[1-9][0-9]{0,3}$ ]] || FOLLOW_TRIES=54
[[ $FOLLOW_PAUSE =~ ^[0-9]{1,3}$ ]] || FOLLOW_PAUSE=10

# shellcheck source=../common/lib.sh
. "$LIB" 2>/dev/null || { printf '{"ok":false,"error":"internal","message":"bibliothèque introuvable"}\n'; exit 1; }
hl_load_conf "$CONF" || { printf '{"ok":false,"error":"config","message":"configuration illisible"}\n'; exit 1; }
ACTION_LOG=${ACTION_LOG:-/var/log/homelab/actions.log}

# ── Serveur ──────────────────────────────────────────────────────────────────
power_json() { # batterie et secteur (le serveur est un portable)
  local p bat="" ac=""
  for p in /sys/class/power_supply/*; do
    [ -r "$p/type" ] || continue
    case "$(cat "$p/type")" in
      Battery) [ -z "$bat" ] && bat=$(cat "$p/capacity" 2>/dev/null) ;;
      Mains)   ac=$(cat "$p/online" 2>/dev/null) ;;
    esac
  done
  if [[ $bat =~ ^[0-9]{1,3}$ ]]; then printf '"battery_pct":%s' "$bat"; else printf '"battery_pct":null'; fi
  case "$ac" in
    1) printf ',"on_ac":true' ;;
    0) printf ',"on_ac":false' ;;
    *) printf ',"on_ac":null' ;;
  esac
}

link_json() { # état du câble vers la tour
  local c=""
  if hl_valid_iface "${LINK_INTERFACE:-}" && [ -e "/sys/class/net/$LINK_INTERFACE" ]; then
    c=$(cat "/sys/class/net/$LINK_INTERFACE/carrier" 2>/dev/null)
    if [ "$c" = "1" ]; then printf '"present":true,"carrier":true'; else printf '"present":true,"carrier":false'; fi
  else
    printf '"present":false,"carrier":false'
  fi
}

# ── Tour ─────────────────────────────────────────────────────────────────────
reachable() { # reachable HÔTE : 1 seconde maximum
  local rc=2
  if command -v ping >/dev/null 2>&1; then
    ping -4 -c 1 -W 1 -q "$1" >/dev/null 2>&1
    rc=$?
    [ "$rc" -le 1 ] && return "$rc"      # 0 = répond, 1 = ne répond pas
  fi
  # ping absent ou inutilisable : on tente le port SSH.
  timeout 1 bash -c ': > "/dev/tcp/$0/22"' "$1" 2>/dev/null
}

tower_paths() { # chemins joignables vers la tour, câble d'abord : « link vpn », « link », « vpn » ou rien
  local d r=""
  d=$(mktemp -d) || return 0
  # Les deux chemins sont testés en même temps : 1 seconde au plus.
  if hl_valid_ipv4 "${LINK_TOWER_IP:-}"; then (reachable "$LINK_TOWER_IP" && : > "$d/link") & fi
  if hl_valid_host "${TOWER_HOST:-}"; then (reachable "$TOWER_HOST" && : > "$d/vpn") & fi
  wait
  [ -e "$d/link" ] && r="link"
  [ -e "$d/vpn" ] && r="${r:+$r }vpn"
  rm -rf "$d"
  printf '%s' "$r"
}

# Envoie une commande au script « tour » de la tour, avec la clé restreinte du
# serveur, par le premier chemin qui fonctionne. Affiche « CHEMIN RÉPONSE »
# (réponse = une ligne JSON) ; échoue si aucune réponse valide.
# On ne passe au chemin suivant que si la connexion a échoué (code 255 : la
# commande n'a pas été lancée), pour ne jamais exécuter une action deux fois.
relay() { # relay "CHEMINS" COMMANDE…
  local paths=$1 p host out rc
  shift
  [ -r "$RELAY_KEY" ] || return 3
  for p in $paths; do
    case "$p" in
      link) host=${LINK_TOWER_IP:-} ;;
      vpn)  host=${TOWER_HOST:-} ;;
      *)    continue ;;
    esac
    [ -n "$host" ] || continue
    # HostKeyAlias : le câble et le VPN sont vérifiés contre la MÊME empreinte
    # de la tour, enregistrée à la toute première connexion.
    # AddressFamily=inet : toujours en IPv4, pour que l'adresse vue par la tour
    # corresponde à TOWER_KEY_FROM.
    out=$(timeout "$RELAY_TIMEOUT" ssh -n -F /dev/null -i "$RELAY_KEY" -o IdentitiesOnly=yes -o BatchMode=yes \
          -o AddressFamily=inet -o ConnectTimeout=3 \
          -o StrictHostKeyChecking=accept-new -o HostKeyAlias=homelab-tower \
          -o UserKnownHostsFile="$RELAY_KNOWN" -o GlobalKnownHostsFile=/dev/null -o LogLevel=ERROR \
          "homelab@$host" "$*" 2>/dev/null)
    rc=$?
    [ "$rc" -eq 255 ] && continue
    out=${out%%$'\n'*}
    [[ $out == '{"ok":'*'}' ]] || return 4
    printf '%s %s' "$p" "$out"
    return 0
  done
  return 4
}

tower_json() { # tower_json [COMMANDE] : réponse de la tour à « status » (ou à COMMANDE)
  local paths res
  paths=$(tower_paths)
  if [ -z "$paths" ]; then
    printf '"online":false,"via":null,"detail":null'
    return
  fi
  if res=$(relay "$paths" "${1:-status}"); then
    printf '"online":true,"via":"%s","detail":%s' "${res%% *}" "${res#* }"
  else
    printf '"online":true,"via":"%s","detail":null' "${paths%% *}"
  fi
}

webcam_json() { # port local de la webcam (joignable par tunnel SSH), ou null
  if hl_in_range "${WEBCAM_PORT:-}" 1 65535; then
    printf '"webcam":{"port":%d}' "$WEBCAM_PORT"
  else
    printf '"webcam":null'
  fi
}

schedule_json() { # allumages programmés (WAKE_SCHEDULE) et prochain allumage
  local spec v next=null first=1
  local -a specs=()
  IFS=';' read -r -a specs <<< "${WAKE_SCHEDULE:-}"
  printf '"wake_schedule":{"specs":['
  for spec in "${specs[@]}"; do
    spec=${spec#"${spec%%[![:space:]]*}"}
    spec=${spec%"${spec##*[![:space:]]}"}
    [[ $spec =~ ^[A-Za-z0-9\ ,:*./~-]{1,80}$ ]] || continue
    if [ "$first" -eq 1 ]; then first=0; else printf ','; fi
    hl_json_str "$spec"
  done
  v=$(timeout 3 systemctl show homelab-wake.timer -p NextElapseUSecRealtime --value --timestamp=unix 2>/dev/null) || v=""
  [[ $v =~ ^@([0-9]{1,12})$ ]] && next=$(hl_json_str "$(hl_iso "${BASH_REMATCH[1]}")")
  printf '],"next":%s}' "$next"
}

# ── Actions ──────────────────────────────────────────────────────────────────
cmd_status() {
  local probe pid cpu mem temp disk power link tower up l1 l5 l15 v
  probe=$(mktemp) || hl_fail_json internal "fichier temporaire impossible"
  tower_json > "$probe" &          # la tour est interrogée en parallèle
  pid=$!
  cpu=$(hl_cpu_pct)
  up=$(hl_uptime_s)
  read -r l1 l5 l15 _ < /proc/loadavg
  for v in l1 l5 l15; do [[ ${!v} =~ ^[0-9]+\.[0-9]+$ ]] || printf -v "$v" 'null'; done
  mem=$(hl_mem_used_pct)
  temp=$(hl_cpu_temp)
  disk=$(hl_disk_used_pct)
  power=$(power_json)
  link=$(link_json)
  wait "$pid"
  tower=$(<"$probe")
  rm -f "$probe"
  printf '{"ok":true,"api":%d,"time":%s,"server":{"uptime_s":%d,"load":[%s,%s,%s],"cpu_pct":%s,"mem_used_pct":%s,"temp_c":%s,"disk_used_pct":%s,%s,%s},"link":{%s},"tower":{%s},%s,%s}\n' \
    "$HOMELAB_API" "$(hl_json_str "$(hl_now)")" "${up:-0}" "$l1" "$l5" "$l15" \
    "$cpu" "$mem" "$temp" "$disk" "$power" "$(hl_wifi_json)" "$link" "$tower" "$(webcam_json)" "$(schedule_json)"
}

cmd_health() {
  local probe pid priv tower
  probe=$(mktemp) || hl_fail_json internal "fichier temporaire impossible"
  RELAY_TIMEOUT=25                 # lecture des disques de la tour comprise
  tower_json health > "$probe" &   # la tour est interrogée en parallèle
  pid=$!
  # Disques et sécurité : lecture en root, par la seule commande autorisée.
  priv=$(sudo -n "$ROOT_HELPER" health 2>/dev/null) || priv=""
  [[ $priv == '"disks":'* && $priv != *$'\n'* ]] || priv='"disks":null,"security":null'
  wait "$pid"
  tower=$(<"$probe")
  rm -f "$probe"
  printf '{"ok":true,"api":%d,"time":%s,"server":{%s,%s},"tower":{%s}}\n' \
    "$HOMELAB_API" "$(hl_json_str "$(hl_now)")" \
    "$(hl_services_json "${SERVER_SERVICES:-}" "${SERVER_RESTARTABLE:-}")" "$priv" "$tower"
}

# Après un réveil (lancé par homelab-root wake, avec le compte homelab) :
# attend que la tour réponde, puis lui signale que l'allumage vient du serveur.
cmd_wake_follow() {
  local i paths res out
  for ((i = 0; i < FOLLOW_TRIES; i++)); do
    [ "$i" -gt 0 ] && sleep "$FOLLOW_PAUSE"
    paths=$(tower_paths)
    [ -n "$paths" ] || continue
    res=$(relay "$paths" woke-by-server) || continue
    out=${res#* }
    if [[ $out == '{"ok":true'* ]]; then
      hl_log_action wake-follow marked
      printf '%s\n' "$out"
      return 0
    fi
    # Refusé par la tour (par exemple, elle était déjà allumée) : on s'arrête.
    hl_log_action wake-follow refused_by_tower
    printf '%s\n' "$out"
    return 1
  done
  hl_log_action wake-follow timeout
  return 1
}

cmd_wake() {
  local now last=0 cooldown=${WAKE_COOLDOWN_S:-20}
  hl_valid_iface "${LINK_INTERFACE:-}" && hl_valid_mac "${TOWER_MAC:-}" \
    || hl_fail_json config "LINK_INTERFACE ou TOWER_MAC invalide dans la configuration"
  hl_valid_uint "$cooldown" || cooldown=20
  mkdir -p "$STATE_DIR" 2>/dev/null
  exec 9> "$STATE_DIR/wake.lock" || hl_fail_json internal "verrou impossible"
  if ! flock -n 9; then
    hl_log_action wake busy
    printf '{"ok":true,"action":"wake","result":"busy"}\n'
    return 0
  fi
  if [ -n "$(tower_paths)" ]; then
    hl_log_action wake already_on
    printf '{"ok":true,"action":"wake","result":"already_on"}\n'
    return 0
  fi
  now=$(date +%s)
  [ -r "$STATE_DIR/last_wake" ] && last=$(<"$STATE_DIR/last_wake")
  hl_valid_uint "${last:-}" || last=0
  if [ $((now - last)) -lt "$cooldown" ]; then
    hl_log_action wake ignored_recent
    printf '{"ok":true,"action":"wake","result":"ignored_recent"}\n'
    return 0
  fi
  printf '%s\n' "$now" > "$STATE_DIR/last_wake"
  if sudo -n "$ROOT_HELPER" wake >/dev/null 2>&1; then
    hl_log_action wake sent
    printf '{"ok":true,"action":"wake","result":"sent"}\n'
  else
    hl_log_action wake failed
    hl_fail_json wake_failed "l'envoi du paquet de réveil a échoué"
  fi
}

# Action exécutée sur la tour : la réponse de la tour est renvoyée dans « tower ».
cmd_tower() { # cmd_tower NOM_DANS_LE_JOURNAL COMMANDE_TOUR…
  local name=$1 paths res via out
  shift
  paths=$(tower_paths)
  if [ -z "$paths" ]; then
    if [ "$name" = "tower-off" ]; then
      hl_log_action "$name" already_off
      printf '{"ok":true,"action":"tower-off","result":"already_off"}\n'
      return 0
    fi
    hl_log_action "$name" tower_offline
    hl_fail_json tower_offline "la tour est éteinte ou injoignable"
  fi
  if ! res=$(relay "$paths" "$@"); then
    hl_log_action "$name" relay_failed
    hl_fail_json relay_failed "la tour n'a pas répondu correctement"
  fi
  via=${res%% *}
  out=${res#* }
  if [[ $out == '{"ok":true'* ]]; then
    hl_log_action "$name" ok
    printf '{"ok":true,"action":%s,"via":"%s","tower":%s}\n' "$(hl_json_str "$name")" "$via" "$out"
  else
    hl_log_action "$name" refused_by_tower
    printf '{"ok":false,"error":"tower_error","message":"la tour a refusé l'"'"'action","tower":%s}\n' "$out"
    exit 1
  fi
}

cmd_log() { # cmd_log N
  local line first=1
  printf '{"ok":true,"entries":['
  if [ -r "$ACTION_LOG" ]; then
    while IFS= read -r line; do
      [[ $line == \{*\} ]] || continue
      if [ "$first" -eq 1 ]; then first=0; else printf ','; fi
      printf '%s' "$line"
    done < <(tail -n "$1" "$ACTION_LOG")
  fi
  printf ']}\n'
}

cmd_actions() {
  printf '{"ok":true,"actions":["status","health","wake","tower-off","tower-reboot","extend","extend-min","off-in","hold","restart","tower-restart","log","actions","version"]}\n'
}

cmd_version() {
  printf '{"ok":true,"version":%s,"api":%d}\n' "$(hl_json_str "$HOMELAB_VERSION")" "$HOMELAB_API"
}

# ── Lecture de la commande ───────────────────────────────────────────────────
hl_parse_command "$@"
ACTION=${ARGS[0]:-actions}
NARGS=${#ARGS[@]}

case "$ACTION" in
  status)
    [ "$NARGS" -le 1 ] || hl_refuse "bad_args" "status ne prend pas d'argument"
    cmd_status ;;
  health)
    [ "$NARGS" -le 1 ] || hl_refuse "bad_args" "health ne prend pas d'argument"
    cmd_health ;;
  wake-follow)
    # Jamais depuis le téléphone : seulement la tâche lancée par homelab-root.
    [ "$VIA" != "ssh" ] || hl_refuse "unknown_action" "action inconnue"
    [ "$NARGS" -le 1 ] || hl_refuse "bad_args" "wake-follow ne prend pas d'argument"
    cmd_wake_follow ;;
  wake)
    [ "$NARGS" -le 1 ] || hl_refuse "bad_args" "wake ne prend pas d'argument"
    cmd_wake ;;
  tower-off)
    [ "$NARGS" -le 1 ] || hl_refuse "bad_args" "tower-off ne prend pas d'argument"
    cmd_tower tower-off shutdown ;;
  tower-reboot)
    [ "$NARGS" -le 1 ] || hl_refuse "bad_args" "tower-reboot ne prend pas d'argument"
    cmd_tower tower-reboot reboot ;;
  extend)
    [ "$NARGS" -le 2 ] || hl_refuse "bad_args" "usage : extend [H]"
    if [ "$NARGS" -eq 2 ]; then
      hl_in_range "${ARGS[1]}" 1 720 || hl_refuse "bad_args" "H doit être un nombre d'heures entre 1 et 720"
      cmd_tower extend extend "${ARGS[1]}"
    else
      cmd_tower extend extend
    fi ;;
  extend-min)
    [ "$NARGS" -eq 2 ] || hl_refuse "bad_args" "usage : extend-min M"
    hl_in_range "${ARGS[1]}" 1 43200 || hl_refuse "bad_args" "M doit être un nombre de minutes entre 1 et 43200"
    cmd_tower extend-min extend-min "${ARGS[1]}" ;;
  off-in)
    [ "$NARGS" -eq 2 ] || hl_refuse "bad_args" "usage : off-in N"
    hl_in_range "${ARGS[1]}" 1 10080 || hl_refuse "bad_args" "N doit être un nombre de minutes entre 1 et 10080"
    cmd_tower off-in off-in "${ARGS[1]}" ;;
  hold)
    [ "$NARGS" -eq 2 ] || hl_refuse "bad_args" "usage : hold on|off"
    case "${ARGS[1]}" in
      on|off) cmd_tower "hold ${ARGS[1]}" hold "${ARGS[1]}" ;;
      *)      hl_refuse "bad_args" "usage : hold on|off" ;;
    esac ;;
  restart)
    [ "$NARGS" -eq 2 ] || hl_refuse "bad_args" "usage : restart SERVICE"
    hl_restart_allowed "${ARGS[1]}" "${SERVER_RESTARTABLE:-}" \
      || hl_refuse "not_allowed" "service non autorisé au redémarrage (SERVER_RESTARTABLE)"
    hl_restart_reply "$ROOT_HELPER" "${ARGS[1]}" ;;
  tower-restart)
    # La liste des services autorisés est celle de la tour : elle décide.
    [ "$NARGS" -eq 2 ] || hl_refuse "bad_args" "usage : tower-restart SERVICE"
    hl_valid_restartable "${ARGS[1]}" || hl_refuse "bad_args" "nom de service invalide"
    RELAY_TIMEOUT=60               # redémarrage : 45 s au plus sur la tour
    cmd_tower "tower-restart ${ARGS[1]}" restart "${ARGS[1]}" ;;
  log)
    [ "$NARGS" -le 2 ] || hl_refuse "bad_args" "usage : log [N]"
    N=${ARGS[1]:-20}
    hl_in_range "$N" 1 200 || hl_refuse "bad_args" "N doit être compris entre 1 et 200"
    cmd_log "$N" ;;
  actions|help)
    [ "$NARGS" -le 1 ] || hl_refuse "bad_args" "actions ne prend pas d'argument"
    cmd_actions ;;
  version)
    [ "$NARGS" -le 1 ] || hl_refuse "bad_args" "version ne prend pas d'argument"
    cmd_version ;;
  *)
    hl_refuse "unknown_action" "action inconnue" ;;
esac
